# The ql-backend WebSocket. `./build/ql-backend --port 9111`, loopback only.
VITE_WS_URL=ws://127.0.0.1:9111

# The built user's guide, opened by the `guide` button in the status bar.
# `npm run docs` writes it here, and the dev server serves it from the project
# root; set this if it is served from somewhere else.
VITE_DOCS_URL=/doc/_build/html/index.html
