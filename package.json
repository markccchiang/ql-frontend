{
    "name": "ql-frontend",
    "private": true,
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "gen": "rm -rf src/gen && buf generate proto",
        "prepare": "npm run gen && husky",
        "dev": "vite",
        "build": "npm run gen && tsc -b && vite build",
        "typecheck": "tsc -p tsconfig.json --noEmit --pretty",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "checkformat": "prettier --check ./src",
        "check-eslint": "eslint ./src ./e2e",
        "fix-eslint": "eslint --fix ./src ./e2e",
        "docs": "sh doc/build.sh",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.2.3",
        "@mantine/core": "^7.15.0",
        "@mantine/hooks": "^7.15.0",
        "@mantine/notifications": "^7.15.0",
        "@reduxjs/toolkit": "^2.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-redux": "^9.2.0",
        "uplot": "^1.6.32"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@bufbuild/buf": "^1.47.2",
        "@bufbuild/protoc-gen-es": "^2.2.3",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-tsdoc": "^0.5.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "postcss": "^8.4.49",
        "postcss-preset-mantine": "^1.17.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "{src,e2e}/**/*.{js,jsx,ts,tsx}": [
            "prettier --write --ignore-unknown",
            "eslint --fix"
        ],
        "{src,e2e}/**/*.{css,json,yml,yaml}": [
            "prettier --write --ignore-unknown"
        ]
    }
}
