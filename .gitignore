node_modules/
dist/
# Generated Protobuf bindings. Not committed, matching ql-protobuf's own rule:
# one source of truth, no stale bindings. `npm run gen` rebuilds them.
src/gen/
*.local
.DS_Store
tsconfig.tsbuildinfo

# Playwright
test-results/
playwright-report/

# Sphinx build output
doc/_build/

# The docs virtualenv (doc/requirements.txt is what it holds).
doc/.venv/

# Compiled message catalogues: sphinx-build rebuilds them from the .po files.
doc/locale/**/*.mo

# Local overrides of .env.example, which may hold the service's token. The
# example is tracked; a file with a real secret in it is not.
.env
.env.local
