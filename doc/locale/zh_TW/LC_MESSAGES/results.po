msgstr "取樣對象"

#: ../../results.md 6987b5afca324c378b7b5539f7d716a2
msgid "Needs"
msgstr "需要什麼"

#: ../../results.md b3ed19b678ff4a0c93e0023a048f6a34
msgid "zero rate"
msgstr "零息利率"

