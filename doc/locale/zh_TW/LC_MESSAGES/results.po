#: ac10ec108c4448b09de7e584069b18e3
msgid "leg NPV, leg BPS"
msgstr "各腳淨現值、各腳 BPS"

#: ../../../Users/mark/WebstormProjects/ql-frontend/doc/results.md
#: 6201b4e4561e488f8d626de3bee2b41c
